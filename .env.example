# --- Google OAuth (Gmail API) ---
# Credenciales de un cliente OAuth 2.0 (tipo "Aplicación de escritorio" o "Web")
# creado en https://console.cloud.google.com con el scope
# https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# Tu Gmail: actúa como remitente y recibe copia en los envíos a administración.
TEST_EMAIL=tu@gmail.com

# Correo de la administración del condominio.
ADMIN_EMAIL=administracion@condominio.cl

# --- Login con Google (Auth.js) ---
# El mismo cliente OAuth de arriba, siempre que sea de tipo "Web application"
# con http://localhost:3000/api/auth/callback/google (dev) y
# https://<tu-dominio>/api/auth/callback/google (prod) como Authorized redirect URIs
# en Google Cloud Console. Si el cliente es de tipo "Desktop app", crea uno nuevo
# tipo "Web application" solo para esto.

# Genera con: npx auth secret
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Correos autorizados a iniciar sesión, separados por coma.
AUTHORIZED_EMAILS=tu@gmail.com
